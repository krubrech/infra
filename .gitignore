# Encrypted secrets ARE committed — that is the point of sops. Only plaintext
# is dangerous, and none of it is written here.
*.age
*.secret
# Decrypted output, if anyone ever redirects sops -d to a file by accident.
*.plain

# WireGuard client configs (contain private keys)
wireguard-client.conf
wg*.conf
