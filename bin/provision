#!/usr/bin/env bash
# Create a Hetzner Cloud VM and turn it into one of this repo's NixOS hosts.
#
# Converts the stock Ubuntu image to NixOS *in place* with nixos-infect (no
# kexec, no reformat — DEPLOY.md has the why). Then pulls the generated
# hardware-configuration.nix back into hosts/<host>/, installs the sops age
# key so the box can decrypt secrets/<host>/*, and deploys .#<host>. Safe to
# re-run after a partial failure: it skips steps that are already done (server
# exists, already NixOS, age key present).
#
# Normally reached as `./infra.sh setup <host>`.
#
# Prerequisites:
#   - hcloud CLI with HCLOUD_TOKEN for the Hetzner project the box lives in
#     (add it to .sops.env: `sops .sops.env`)
#   - the sops age key at ~/.config/sops/age/keys.txt (or SOPS_AGE_KEY_FILE)
#
# Usage:
#   bin/provision <host> [OPTIONS]
#
# Options:
#   --ssh-key       Hetzner SSH key name. Default: auto — match a local
#                   ~/.ssh public key against the project by fingerprint,
#                   uploading it first if it isn't there yet
#   --location      Hetzner location (default: fsn1)
#   --server-type   Hetzner server type (default: cx23)
#   --primary-ipv4  Existing primary IP (id or name) to attach — lets you
#                   reuse the old box's IP so DNS keeps working
#   --existing      The server already exists; skip creation and infect it
set -euo pipefail
cd "$(dirname "$0")/.."

# --- Configuration ---

SERVER_NAME=""
LOCATION="fsn1"
SERVER_TYPE="cx23"
SSH_KEY_NAME=""
PRIMARY_IPV4=""
EXISTING=false

# --- Parse arguments ---

while [[ $# -gt 0 ]]; do
  case "$1" in
    --location)     LOCATION="$2"; shift 2 ;;
    --server-type)  SERVER_TYPE="$2"; shift 2 ;;
    --ssh-key)      SSH_KEY_NAME="$2"; shift 2 ;;
    --primary-ipv4) PRIMARY_IPV4="$2"; shift 2 ;;
    --existing)     EXISTING=true; shift ;;
    --help)
      awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
      exit 0
      ;;
    -*) echo "Unknown option: $1"; exit 1 ;;
    *)  [ -z "$SERVER_NAME" ] || { echo "One host at a time (got '$SERVER_NAME' and '$1')"; exit 1; }
        SERVER_NAME="$1"; shift ;;
  esac
done

# The Hetzner server is named after the host, so hosts/<name>/ and
# secrets/<name>/ are where everything else about it lives.
[ -n "$SERVER_NAME" ] || { echo "Usage: bin/provision <host> [OPTIONS]"; exit 1; }
HOST_DIR="hosts/$SERVER_NAME"

log() { echo "[provision] $(date -u +%H:%M:%S) $*"; }

# The host key changes twice (Ubuntu -> installer-less infect -> NixOS), so
# host key checking is off for the whole run.
SSH_OPTS=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o LogLevel=ERROR)
remote() { ssh "${SSH_OPTS[@]}" "root@$SERVER_IP" "$@"; }

# --- Preflight checks ---

[ -d "$HOST_DIR" ] || { log "ERROR: $HOST_DIR does not exist — declare the machine first"; exit 1; }
command -v hcloud >/dev/null 2>&1 || { log "ERROR: hcloud not found (enter the dev shell)"; exit 1; }
command -v jq >/dev/null 2>&1 || { log "ERROR: jq not found"; exit 1; }
git rev-parse --is-inside-work-tree >/dev/null || { log "ERROR: not in the infra git repo"; exit 1; }

# Hetzner requires an SSH key at creation time (otherwise it mails a root
# password and we can't get in). Unless --ssh-key names one explicitly, find
# the project key matching a local public key by fingerprint — uploading the
# local key first if the project doesn't have it.
resolve_ssh_key() {
  [ -n "$SSH_KEY_NAME" ] && return 0
  local pub fp
  for pub in "$HOME"/.ssh/id_ed25519.pub "$HOME"/.ssh/id_rsa.pub; do
    [ -r "$pub" ] || continue
    fp=$(ssh-keygen -E md5 -lf "$pub" | awk '{print $2}' | sed 's/^MD5://')
    SSH_KEY_NAME=$(hcloud ssh-key list -o json |
      jq -r --arg fp "$fp" '[.[] | select(.fingerprint == $fp) | .name] | first // empty')
    if [ -n "$SSH_KEY_NAME" ]; then
      log "Using Hetzner SSH key '$SSH_KEY_NAME' (matches $pub)"
      return 0
    fi
  done
  for pub in "$HOME"/.ssh/id_ed25519.pub "$HOME"/.ssh/id_rsa.pub; do
    [ -r "$pub" ] || continue
    SSH_KEY_NAME=$(cut -d' ' -f3- "$pub" | tr ' ' '-')
    SSH_KEY_NAME=${SSH_KEY_NAME:-$SERVER_NAME-deploy}
    log "Uploading $pub to Hetzner as '$SSH_KEY_NAME'..."
    hcloud ssh-key create --name "$SSH_KEY_NAME" --public-key-from-file "$pub" >/dev/null
    return 0
  done
  log "ERROR: no local SSH key found (~/.ssh/id_ed25519.pub or id_rsa.pub) — pass --ssh-key"
  return 1
}

# --- Step 1: Create the server (or adopt an existing one) ---

if $EXISTING || hcloud server describe "$SERVER_NAME" >/dev/null 2>&1; then
  log "Using existing server '$SERVER_NAME'."
else
  resolve_ssh_key
  log "Creating server '$SERVER_NAME' in $LOCATION ($SERVER_TYPE)..."
  CREATE_ARGS=(
    --name "$SERVER_NAME"
    --type "$SERVER_TYPE"
    --image "ubuntu-24.04"
    --location "$LOCATION"
    --ssh-key "$SSH_KEY_NAME"
    --label "infra=$SERVER_NAME"
  )
  if [ -n "$PRIMARY_IPV4" ]; then
    CREATE_ARGS+=(--primary-ipv4 "$PRIMARY_IPV4")
  fi
  hcloud server create "${CREATE_ARGS[@]}" >/dev/null
fi

SERVER_IP=$(hcloud server ip "$SERVER_NAME")
log "Server '$SERVER_NAME' is at $SERVER_IP"

# --- Step 2: Wait for SSH ---

log "Waiting for SSH access..."
for i in $(seq 1 60); do
  if remote "echo ok" >/dev/null 2>&1; then
    log "SSH accessible."
    break
  fi
  if [ "$i" -eq 60 ]; then
    log "ERROR: SSH not accessible after 5 minutes"
    exit 1
  fi
  sleep 5
done

# --- Step 3: Secure Boot preflight ---
#
# nixos-infect installs an unsigned bootloader. Under UEFI Secure Boot the
# box would install fine and then fail to boot — so refuse to proceed.
# (This is also what broke the old nixos-anywhere path: kexec of an unsigned
# kernel is blocked by the SB lockdown, "PEFILE: Unsigned PE binary".)

if ! remote "test -e /etc/NIXOS" 2>/dev/null; then
  log "Checking firmware / Secure Boot state..."
  SB_STATE=$(remote '
    if [ -d /sys/firmware/efi ]; then
      var=$(ls /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | head -1)
      if [ -n "$var" ] && [ "$(od -An -tu1 -j4 -N1 "$var" | tr -d " ")" = "1" ]; then
        echo uefi-secureboot
      else
        echo uefi
      fi
    else
      echo bios
    fi
  ')
  log "Firmware: $SB_STATE"
  if [ "$SB_STATE" = "uefi-secureboot" ]; then
    log "ERROR: Secure Boot is enabled — the infected system would not boot."
    log "Disable it via the Hetzner Cloud web console:"
    log "  server -> Console -> reboot -> ESC into firmware setup ->"
    log "  Device Manager -> Secure Boot Configuration -> uncheck 'Attempt Secure Boot'"
    log "then re-run: bin/provision --existing --name $SERVER_NAME"
    exit 1
  fi
fi

# --- Step 4: Convert to NixOS with nixos-infect ---

if remote "test -e /etc/NIXOS" 2>/dev/null; then
  log "Server is already NixOS — skipping nixos-infect."
else
  log "Running nixos-infect (this takes a few minutes)..."
  remote bash <<'INFECT_EOF' || true
    mkdir -p /etc/nixos
    # Two workarounds for infect on current nixos-unstable (learned the hard
    # way — see DEPLOY.md "Troubleshooting"):
    #
    #  1. The systemd-based initrd (the new default) skips the NIXOS_LUSTRATE
    #     step that moves the old distro to /old-root on first boot, leaving
    #     Ubuntu's /etc in place and systemd running a broken mix of both
    #     systems. Force the scripted initrd for the bootstrap system; the
    #     flake config deployed on top may use whatever it wants.
    #
    #  2. infect declares the IPv4 default gateway without an interface,
    #     which is applied by network-setup.service — and that never ran,
    #     leaving the box unreachable over IPv4. Interface-scoped gateways
    #     are applied by the per-interface unit, which works. Hetzner
    #     Cloud's IPv4 gateway is always 172.31.1.1.
    cat > /etc/nixos/infect-extras.nix <<'NIXEOF'
{ lib, ... }: {
  boot.initrd.systemd.enable = lib.mkForce false;
  networking.defaultGateway = lib.mkForce {
    address = "172.31.1.1";
    interface = "eth0";
  };
}
NIXEOF
    curl -L https://raw.githubusercontent.com/elitak/nixos-infect/master/nixos-infect | \
      NIX_CHANNEL=nixos-unstable PROVIDER=hetznercloud NO_REBOOT=1 \
      NIXOS_IMPORT=./infect-extras.nix bash 2>&1
INFECT_EOF

  log "Installing NixOS bootloader..."
  remote "test -e /nix/var/nix/profiles/system/bin/switch-to-configuration" || {
    log "ERROR: nixos-infect did not produce a system profile — check its output above"
    exit 1
  }
  remote "/nix/var/nix/profiles/system/bin/switch-to-configuration boot"

  log "Rebooting into NixOS..."
  remote "reboot" 2>/dev/null || true
  sleep 30

  log "Waiting for NixOS to boot..."
  for i in $(seq 1 60); do
    if remote "nixos-version" >/dev/null 2>&1; then
      log "NixOS is running: $(remote nixos-version)"
      break
    fi
    if [ "$i" -eq 60 ]; then
      log "ERROR: NixOS did not come up after 5 minutes"
      exit 1
    fi
    sleep 5
  done
fi

# --- Step 5: Pull the generated hardware config into the repo ---
#
# nixos-infect writes hardware-configuration.nix (bootloader device, initrd
# modules, root fs) for the disk layout it inherited from the Ubuntu image.
# The flake imports it, so it must live in the repo and be git-tracked.

log "Fetching /etc/nixos/hardware-configuration.nix into $HOST_DIR/..."
remote "cat /etc/nixos/hardware-configuration.nix" > "$HOST_DIR/hardware-configuration.nix"
git add "$HOST_DIR/hardware-configuration.nix"
log "Saved (remember to commit it)."

# --- Step 6: Install the sops age key (only if missing) ---
#
# Prod secrets themselves live encrypted in the repo (secrets/<host>/*) and
# are decrypted on the box by sops-nix at activation. All the box needs is
# the age private key — the same identity that decrypts .sops.env in the
# dev shell. We drop it out of band here; sops-nix reads it from
# /var/lib/sops-nix/age/keys.txt (see $HOST_DIR/configuration.nix).

AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
if remote "test -s /var/lib/sops-nix/age/keys.txt" 2>/dev/null; then
  log "sops age key already present — leaving it untouched."
elif [ -r "$AGE_KEY_FILE" ]; then
  log "Installing sops age key from $AGE_KEY_FILE..."
  remote "umask 077 && mkdir -p /var/lib/sops-nix/age && cat > /var/lib/sops-nix/age/keys.txt" < "$AGE_KEY_FILE"
  log "Age key installed — sops-nix will decrypt secrets/$SERVER_NAME/* on the box."
else
  log "ERROR: sops age key not found at $AGE_KEY_FILE."
  log "  Set SOPS_AGE_KEY_FILE to its path, or place it there, then re-run"
  log "  with --existing. Without it, sops-nix can't decrypt the app secrets."
  exit 1
fi

# --- Step 7: Deploy the koura host config ---
#
# Builds on the server (its uplink is much faster than pushing a closure from
# here). Evaluation happens locally, so untracked files are invisible — the
# git add above matters. No app is in this closure; see below.

log "Deploying flake config (builds on the server)..."
export NIX_SSHOPTS="${SSH_OPTS[*]}"
rebuild() {
  if command -v nixos-rebuild >/dev/null 2>&1; then
    nixos-rebuild "$@"
  else
    nix run nixpkgs#nixos-rebuild -- "$@"
  fi
}
rc=0
rebuild switch --flake ".#$SERVER_NAME" \
  --target-host "root@$SERVER_IP" \
  --build-host "root@$SERVER_IP" || rc=$?
if [ "$rc" -eq 4 ]; then
  log "WARNING: switch completed but some units failed to start — inspect with:"
  log "  ssh root@$SERVER_IP journalctl -xe"
elif [ "$rc" -ne 0 ]; then
  log "ERROR: nixos-rebuild failed (exit $rc)"
  exit "$rc"
fi

# --- Done ---
#
# There is deliberately no app deploy here. A release is not part of a host's
# closure: each app builds its own and ships it into /nix/var/nix/profiles/<app>
# from its own repo, and its unit skips (ConditionPathExists) until that
# profile exists. So a fresh box comes up with its units idle, and every app
# lands independently afterwards.

cat <<DONE

============================================
  $SERVER_NAME
  IP:  $SERVER_IP
============================================

Next steps:

1. Commit the generated hardware config — flakes only see git-tracked files,
   and the host will not build without it:
     git add $HOST_DIR/hardware-configuration.nix && git commit

2. Point DNS at $SERVER_IP (or attach the old primary IP):
     ./infra.sh dns            # preview
     ./infra.sh dns --doit     # apply

3. Ship each app from its own repo:
     bin/deploy-app root@$SERVER_IP

   Anything an app needs on top of that — a search index to populate, a
   database to seed — is in that repo's DEPLOY.md.

Afterwards:
  app code   -> bin/deploy-app, in the app's repo (fast: no nixos-rebuild)
  the box    -> ./infra.sh deploy $SERVER_NAME
DONE
