# The tools bin/dns and bin/provision need (octoDNS, hcloud, sops,
# nixos-rebuild). Requires nix-direnv for caching.
use flake

# Dev-shell secrets: DESEC_TOKEN for bin/dns, HCLOUD_TOKEN for bin/provision.
# The encrypted file is what is committed — edit with `sops .sops.env`.
if [ -f .sops.env ]; then
  eval "$(sops -d --output-type dotenv .sops.env | sed 's/^/export /')"
fi

PATH_add bin
